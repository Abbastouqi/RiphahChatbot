# Copy to .env and fill in.  Never commit .env.

# --- OpenAI: embeddings (knowledge base) + Realtime API (voice) ---
OPENAI_API_KEY=sk-...

# --- Anthropic: structured extraction during ingest + text-mode agent ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Models (override only if you know why) ---
EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1536
CLAUDE_MODEL=claude-opus-5
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin

# --- Crawler politeness ---
CRAWL_DELAY_SECONDS=0.5
CRAWL_USER_AGENT=RiphahVoiceAgent/1.0 (university project; contact abbastouqeer399@gmail.com)

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Text chat provider: "anthropic" (Claude) or "openai" ---
TEXT_PROVIDER=anthropic
OPENAI_TEXT_MODEL=gpt-4o

# --- Production API access (leave empty for open local dev) ---
# Comma-separated developer keys; clients must send X-API-Key when set.
API_KEYS=
# Comma-separated allowed browser origins, e.g. https://riphah.edu.pk
ALLOWED_ORIGINS=*
